<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pokerbrain.ui.ReplayController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="topbar">
            <SVGPath content="M7 2 L7 7 L14 7 L14 9 L7 9 L7 14 L1 8 Z"
                     styleClass="icon, icon--accent"/>
            <Label text="Replay commenté" styleClass="title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Menu" onAction="#onBackToMenu" styleClass="btn, btn--ghost"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="16">
            <padding><Insets top="16" bottom="8" left="16" right="16"/></padding>

            <!-- Historique des actions (peuplé par ReplayController) -->
            <VBox spacing="8" styleClass="panel" minWidth="240" prefWidth="300">
                <Label text="Historique" styleClass="section-title"/>
                <Separator/>
                <VBox fx:id="timelineContainer" VBox.vgrow="ALWAYS"/>
            </VBox>

            <!-- État de l'étape -->
            <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS">
                <VBox spacing="12">

                    <VBox spacing="5" styleClass="panel">
                        <Label text="Étape en cours" styleClass="muted"/>
                        <Label fx:id="stepRoundLabel" text="—" styleClass="step__round"/>
                        <Label fx:id="stepActionLabel" text="—" styleClass="step__action"/>
                        <Label fx:id="stepPotLabel" text="Pot —" styleClass="step__pot, num"/>
                    </VBox>

                    <VBox spacing="8" styleClass="panel">
                        <Label text="Board" styleClass="muted"/>
                        <HBox fx:id="replayCommunityRow" spacing="8" alignment="CENTER_LEFT"/>
                    </VBox>

                    <VBox fx:id="equityContainer" spacing="6" styleClass="panel">
                        <Label text="Équité et conseil" styleClass="muted"/>
                    </VBox>

                </VBox>
            </ScrollPane>
        </HBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="12" styleClass="bottombar">
            <Button onAction="#onGoToStart" styleClass="btn, btn--nav">
                <graphic>
                    <SVGPath content="M3 3 L4.5 3 L4.5 13 L3 13 Z M13.5 3 L13.5 13 L6 8 Z"
                             styleClass="icon"/>
                </graphic>
            </Button>
            <Button text="Précédent" onAction="#onPrevStep" styleClass="btn, btn--nav">
                <graphic><SVGPath content="M12 3 L12 13 L4 8 Z" styleClass="icon"/></graphic>
            </Button>
            <Label fx:id="stepCounterLabel" text="Étape — / —" styleClass="step__counter, num"/>
            <Button text="Suivant" onAction="#onNextStep" styleClass="btn, btn--nav">
                <graphic><SVGPath content="M4 3 L12 8 L4 13 Z" styleClass="icon"/></graphic>
            </Button>
            <Button onAction="#onGoToEnd" styleClass="btn, btn--nav">
                <graphic>
                    <SVGPath content="M13 3 L11.5 3 L11.5 13 L13 13 Z M2.5 3 L2.5 13 L10 8 Z"
                             styleClass="icon"/>
                </graphic>
            </Button>
        </HBox>
    </bottom>

</BorderPane>
