<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pokerbrain.ui.ReplayController"
            style="-fx-background-color: #0d3b1e;">

    <!-- En-tête -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: #0a2e18; -fx-padding: 14 20 14 20;">
            <Label text="⏮" style="-fx-font-size: 20px; -fx-text-fill: #2980b9;"/>
            <Label text="Replay d'une main"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Menu" onAction="#onBackToMenu"
                    style="-fx-background-color: transparent; -fx-text-fill: #a09070;
                           -fx-border-color: #a09070; -fx-border-radius: 4px;
                           -fx-padding: 4 12 4 12; -fx-font-size: 12px;"/>
        </HBox>
    </top>

    <!-- Zone principale -->
    <center>
        <HBox spacing="20">
            <padding><Insets top="20" bottom="10" left="20" right="20"/></padding>

            <!-- Panneau gauche : timeline des actions (peuplée par ReplayController) -->
            <VBox spacing="8" prefWidth="320">
                <Label text="Historique"
                       style="-fx-text-fill: #d4af37; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                <Separator style="-fx-background-color: #1a5c32;"/>
                <VBox fx:id="timelineContainer" VBox.vgrow="ALWAYS"/>
            </VBox>

            <!-- Panneau droit : état de l'étape -->
            <VBox spacing="14" HBox.hgrow="ALWAYS">

                <!-- Infos de l'étape courante -->
                <VBox spacing="6"
                      style="-fx-background-color: #163d24; -fx-background-radius: 8px; -fx-padding: 14;">
                    <Label text="Étape en cours"
                           style="-fx-text-fill: #a09070; -fx-font-size: 11px;"/>
                    <Label fx:id="stepRoundLabel" text="—"
                           style="-fx-text-fill: #d4af37; -fx-font-size: 15px; -fx-font-weight: bold;"/>
                    <Label fx:id="stepActionLabel" text="—"
                           style="-fx-text-fill: white; -fx-font-size: 14px;"/>
                    <Label fx:id="stepPotLabel" text="Pot : —"
                           style="-fx-text-fill: #7fcf9f; -fx-font-size: 13px;"/>
                </VBox>

                <!-- Board (peuplé par ReplayController) -->
                <VBox spacing="8"
                      style="-fx-background-color: #163d24; -fx-background-radius: 8px; -fx-padding: 14;">
                    <Label text="Board"
                           style="-fx-text-fill: #a09070; -fx-font-size: 11px;"/>
                    <HBox fx:id="replayCommunityRow" spacing="8" alignment="CENTER_LEFT"/>
                </VBox>

                <!-- Graphique d'équité (peuplé par ReplayController) -->
                <VBox fx:id="equityContainer" spacing="4"
                      style="-fx-background-color: #163d24; -fx-background-radius: 8px; -fx-padding: 14;">
                    <Label text="Équité"
                           style="-fx-text-fill: #a09070; -fx-font-size: 11px;"/>
                </VBox>

            </VBox>
        </HBox>
    </center>

    <!-- Navigation -->
    <bottom>
        <HBox alignment="CENTER" spacing="14"
              style="-fx-background-color: #0a2e18; -fx-padding: 14 20 14 20;">
            <Button text="|◀" onAction="#onGoToStart" prefWidth="50" prefHeight="36"
                    style="-fx-background-color: #1a4a2e; -fx-text-fill: white;
                           -fx-border-color: #2a7a4e; -fx-border-radius: 4px;
                           -fx-background-radius: 4px;"/>
            <Button text="◀ Préc." onAction="#onPrevStep" prefWidth="90" prefHeight="36"
                    style="-fx-background-color: #1a4a2e; -fx-text-fill: white;
                           -fx-border-color: #2a7a4e; -fx-border-radius: 4px;
                           -fx-background-radius: 4px; -fx-font-size: 12px;"/>
            <Label fx:id="stepCounterLabel" text="Étape — / —"
                   style="-fx-text-fill: #d4af37; -fx-font-size: 13px; -fx-font-weight: bold;
                          -fx-min-width: 110px; -fx-alignment: CENTER;"/>
            <Button text="Suiv. ▶" onAction="#onNextStep" prefWidth="90" prefHeight="36"
                    style="-fx-background-color: #1a4a2e; -fx-text-fill: white;
                           -fx-border-color: #2a7a4e; -fx-border-radius: 4px;
                           -fx-background-radius: 4px; -fx-font-size: 12px;"/>
            <Button text="▶|" onAction="#onGoToEnd" prefWidth="50" prefHeight="36"
                    style="-fx-background-color: #1a4a2e; -fx-text-fill: white;
                           -fx-border-color: #2a7a4e; -fx-border-radius: 4px;
                           -fx-background-radius: 4px;"/>
        </HBox>
    </bottom>

</BorderPane>
