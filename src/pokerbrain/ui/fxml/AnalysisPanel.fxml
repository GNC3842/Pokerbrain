<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pokerbrain.ui.AnalysisController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="topbar">
            <SVGPath styleClass="icon, icon--accent"
                     content="M7 1.5 A5.5 5.5 0 1 0 7 12.5 A5.5 5.5 0 1 0 7 1.5 Z
                              M7 3.5 A3.5 3.5 0 1 1 7 10.5 A3.5 3.5 0 1 1 7 3.5 Z
                              M10.9 10.2 L14.5 13.8 L13.4 14.9 L9.8 11.3 Z"/>
            <Label text="Calculateur d'équité" styleClass="title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Menu" onAction="#onBackToMenu" styleClass="btn, btn--ghost"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="16">
            <padding><Insets top="16" bottom="8" left="16" right="16"/></padding>

            <!-- Saisie -->
            <ScrollPane fitToWidth="true" minWidth="300" prefWidth="330">
                <VBox spacing="14">

                    <VBox spacing="8" styleClass="panel">
                        <Label text="Votre main" styleClass="section-title"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <TextField fx:id="heroCard1Field" promptText="As"
                                       styleClass="field, field--card"/>
                            <TextField fx:id="heroCard2Field" promptText="Kh"
                                       styleClass="field, field--card"/>
                        </HBox>
                        <HBox fx:id="heroCardsBox" spacing="6" alignment="CENTER_LEFT"/>
                    </VBox>

                    <VBox spacing="8" styleClass="panel">
                        <Label text="Board (facultatif)" styleClass="section-title"/>
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <TextField fx:id="board1Field" promptText="Flop" styleClass="field, field--board"/>
                            <TextField fx:id="board2Field" promptText="Flop" styleClass="field, field--board"/>
                            <TextField fx:id="board3Field" promptText="Flop" styleClass="field, field--board"/>
                            <TextField fx:id="board4Field" promptText="Turn" styleClass="field, field--board"/>
                            <TextField fx:id="board5Field" promptText="River" styleClass="field, field--board"/>
                        </HBox>
                        <HBox fx:id="boardCardsBox" spacing="6" alignment="CENTER_LEFT"/>
                    </VBox>

                    <VBox spacing="10" styleClass="panel">
                        <Label text="Adversaire" styleClass="section-title"/>

                        <HBox spacing="0">
                            <fx:define><ToggleGroup fx:id="modeGroup"/></fx:define>
                            <ToggleButton fx:id="toggleHandMode" text="Main exacte"
                                          toggleGroup="$modeGroup" selected="true"
                                          styleClass="btn" minHeight="30"
                                          maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                            <ToggleButton fx:id="toggleRangeMode" text="Range"
                                          toggleGroup="$modeGroup"
                                          styleClass="btn" minHeight="30"
                                          maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        </HBox>

                        <VBox fx:id="villainHandBox" spacing="8">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <TextField fx:id="villainCard1Field" promptText="Ah"
                                           styleClass="field, field--card"/>
                                <TextField fx:id="villainCard2Field" promptText="Kd"
                                           styleClass="field, field--card"/>
                            </HBox>
                            <HBox fx:id="villainCardsBox" spacing="6" alignment="CENTER_LEFT"/>
                        </VBox>

                        <VBox fx:id="villainRangeBox" spacing="4" visible="false" managed="false">
                            <Label text="Notation : AA,KK,AKs ou AXs,KQo" styleClass="muted"/>
                            <TextField fx:id="rangeField" promptText="AA,KK,QQ,AKs,AKo"
                                       styleClass="field, field--text"/>
                        </VBox>
                    </VBox>

                    <Button fx:id="calculateButton" text="Calculer l'équité" onAction="#onCalculate"
                            styleClass="btn, btn--primary" maxWidth="Infinity" minHeight="42"/>

                    <Label fx:id="errorLabel" text="" styleClass="error" wrapText="true"/>
                </VBox>
            </ScrollPane>

            <!-- Résultats -->
            <VBox spacing="14" HBox.hgrow="ALWAYS">

                <VBox spacing="8" styleClass="panel">
                    <Label text="Résultat" styleClass="section-title"/>
                    <Separator/>
                    <HBox spacing="36" alignment="CENTER">
                        <VBox spacing="4" alignment="CENTER">
                            <Label text="Vous" styleClass="muted"/>
                            <Label fx:id="heroEquityLabel" text="—" styleClass="equity__big, num"/>
                        </VBox>
                        <VBox spacing="4" alignment="CENTER">
                            <Label text="Partage" styleClass="muted"/>
                            <Label fx:id="tieLabel" text="—" styleClass="equity__mid, num"/>
                        </VBox>
                        <VBox spacing="4" alignment="CENTER">
                            <Label text="Adversaire" styleClass="muted"/>
                            <Label fx:id="villainEquityLabel" text="—" styleClass="equity__big, num"/>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox fx:id="equityChartContainer" styleClass="panel" VBox.vgrow="ALWAYS"/>

            </VBox>
        </HBox>
    </center>

</BorderPane>
