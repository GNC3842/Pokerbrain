<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pokerbrain.ui.GameController"
            style="-fx-background-color: #0d3b1e;">

    <!-- Barre d'info supérieure -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15"
              style="-fx-background-color: #0a2e18; -fx-padding: 10 20 10 20;">
            <Label fx:id="roundLabel" text="PREFLOP"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #d4af37;"/>
            <Label text="|" style="-fx-text-fill: #3a6640;"/>
            <Label text="Pot :" style="-fx-text-fill: #a09070; -fx-font-size: 13px;"/>
            <Label fx:id="potLabel" text="0"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Menu" onAction="#onBackToMenu"
                    style="-fx-background-color: transparent; -fx-text-fill: #a09070;
                           -fx-border-color: #a09070; -fx-border-radius: 4px;
                           -fx-padding: 4 12 4 12; -fx-font-size: 12px;"/>
        </HBox>
    </top>

    <!-- Panneau droit : historique des coups -->
    <right>
        <VBox spacing="8"
              style="-fx-background-color: #0a2e18; -fx-padding: 12 10 12 10; -fx-min-width: 200px;">
            <Label text="Historique"
                   style="-fx-text-fill: #d4af37; -fx-font-size: 13px; -fx-font-weight: bold;"/>
            <VBox fx:id="timelineContainer"/>
        </VBox>
    </right>

    <!-- Zone centrale : adversaires + table -->
    <center>
        <VBox alignment="CENTER" spacing="20">
            <padding><Insets top="20" bottom="10" left="40" right="40"/></padding>

            <!-- Rangée du haut : 3 adversaires (peuplée par GameController) -->
            <HBox fx:id="topRow" alignment="CENTER" spacing="50"/>

            <!-- Rangée du milieu : gauche, cartes communes, droite -->
            <HBox alignment="CENTER" spacing="30">

                <VBox fx:id="leftSlot" alignment="CENTER"/>

                <!-- Cartes communes + pot (peuplés par GameController) -->
                <VBox alignment="CENTER" spacing="10" HBox.hgrow="ALWAYS">
                    <HBox fx:id="communityRow" alignment="CENTER" spacing="8"/>
                    <VBox fx:id="potContainer" alignment="CENTER"/>
                </VBox>

                <VBox fx:id="rightSlot" alignment="CENTER"/>

            </HBox>

            <!-- Rangée du bas : joueurs supplémentaires pour 7-8 joueurs (peuplée par GameController) -->
            <HBox fx:id="bottomRow" alignment="CENTER" spacing="50"/>

        </VBox>
    </center>

    <!-- Zone hero : cartes + boutons d'action -->
    <bottom>
        <HBox alignment="CENTER" spacing="60"
              style="-fx-background-color: #0a2e18; -fx-padding: 18 30 18 30;">

            <!-- Vue héro (peuplée par GameController) -->
            <VBox fx:id="heroSlot" alignment="CENTER"/>

            <!-- Boutons d'action + slider relance -->
            <VBox alignment="CENTER" spacing="10">
                <HBox spacing="12" alignment="CENTER">
                    <Button fx:id="foldButton" text="Fold" onAction="#onFold"
                            prefWidth="130" prefHeight="48"
                            style="-fx-font-size: 14px; -fx-font-weight: bold;
                                   -fx-background-color: #c0392b; -fx-text-fill: white;
                                   -fx-background-radius: 7px;"/>
                    <Button fx:id="checkCallButton" text="Call" onAction="#onCall"
                            prefWidth="130" prefHeight="48"
                            style="-fx-font-size: 14px; -fx-font-weight: bold;
                                   -fx-background-color: #2980b9; -fx-text-fill: white;
                                   -fx-background-radius: 7px;"/>
                    <Button fx:id="raiseButton" text="Raise" onAction="#onRaise"
                            prefWidth="130" prefHeight="48"
                            style="-fx-font-size: 14px; -fx-font-weight: bold;
                                   -fx-background-color: #d4af37; -fx-text-fill: #0d3b1e;
                                   -fx-background-radius: 7px;"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER">
                    <Label text="Amount:" style="-fx-text-fill: #a09070; -fx-font-size: 12px;"/>
                    <Slider fx:id="raiseSlider" min="0" max="0" value="0" prefWidth="200" disable="true"/>
                    <Label fx:id="raiseAmountLabel" text="0"
                           style="-fx-text-fill: white; -fx-font-size: 12px; -fx-min-width: 55px;"/>
                </HBox>
            </VBox>

        </HBox>
    </bottom>

</BorderPane>
