<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  Table de jeu. La racine est un StackPane pour pouvoir superposer l'annonce de fin de
  main : les `Alert` natifs bloquaient le thread FX au milieu des animations et sortaient
  complètement du thème.
-->
<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="pokerbrain.ui.GameController"
           styleClass="table-root">

    <BorderPane>

        <!-- Bandeau d'info -->
        <top>
            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="topbar">
                <Label fx:id="roundLabel" text="PRÉFLOP" styleClass="round-badge"/>
                <Label text="Pot" styleClass="muted"/>
                <Label fx:id="potLabel" text="0" styleClass="title, num"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Menu" onAction="#onBackToMenu" styleClass="btn, btn--ghost"/>
            </HBox>
        </top>

        <!-- Historique des coups -->
        <right>
            <VBox spacing="8" styleClass="side-panel">
                <Label text="Historique" styleClass="section-title"/>
                <VBox fx:id="timelineContainer" VBox.vgrow="ALWAYS"/>
            </VBox>
        </right>

        <!-- Adversaires + ovale de feutre -->
        <center>
            <VBox alignment="CENTER" spacing="14">
                <padding><Insets top="16" bottom="8" left="16" right="16"/></padding>

                <HBox fx:id="topRow" alignment="CENTER" spacing="32"/>

                <HBox alignment="CENTER" spacing="18" VBox.vgrow="ALWAYS">
                    <VBox fx:id="leftSlot" alignment="CENTER"/>

                    <VBox alignment="CENTER" spacing="12" styleClass="felt" HBox.hgrow="ALWAYS">
                        <HBox fx:id="communityRow" alignment="CENTER" spacing="8"/>
                        <VBox fx:id="potContainer" alignment="CENTER" spacing="4"/>
                    </VBox>

                    <VBox fx:id="rightSlot" alignment="CENTER"/>
                </HBox>

                <HBox fx:id="bottomRow" alignment="CENTER" spacing="32"/>
            </VBox>
        </center>

        <!-- Héro : cartes et actions -->
        <bottom>
            <HBox alignment="CENTER" spacing="40" styleClass="bottombar">
                <VBox fx:id="heroSlot" alignment="CENTER"/>

                <VBox alignment="CENTER" spacing="10" HBox.hgrow="ALWAYS">
                    <HBox spacing="12" alignment="CENTER">
                        <Button fx:id="foldButton" text="Fold" onAction="#onFold"
                                styleClass="btn, btn--danger, btn--table"/>
                        <Button fx:id="checkCallButton" text="Check" onAction="#onCall"
                                styleClass="btn, btn--table"/>
                        <Button fx:id="raiseButton" text="Raise" onAction="#onRaise"
                                styleClass="btn, btn--primary, btn--table"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER">
                        <Label text="Raise to" styleClass="muted"/>
                        <Slider fx:id="raiseSlider" min="0" max="0" value="0"
                                minWidth="160" prefWidth="240" disable="true"
                                HBox.hgrow="ALWAYS"/>
                        <Label fx:id="raiseAmountLabel" text="0" styleClass="num" minWidth="90"/>
                    </HBox>
                </VBox>
            </HBox>
        </bottom>

    </BorderPane>

    <!-- Récapitulatif de fin de main : non bloquant, masqué par défaut -->
    <StackPane fx:id="overlay" styleClass="overlay" visible="false" managed="false">
        <VBox alignment="CENTER" spacing="10" styleClass="overlay__box" maxWidth="460"
              maxHeight="440">
            <Label fx:id="overlayTitle" text="" styleClass="overlay__title"/>
            <Label fx:id="overlayDetail" text="" styleClass="overlay__detail" wrapText="true"/>
            <VBox fx:id="recapBox" alignment="CENTER_LEFT" spacing="2"/>
            <Button fx:id="nextHandButton" text="Main suivante" onAction="#onNextHand"
                    styleClass="btn, btn--primary"/>
        </VBox>
    </StackPane>

</StackPane>
